<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="104857600" />
      </requestFiltering>
    </security>
    <aspNetCore processPath="dotnet" arguments=".\APIDRODIN.dll" hostingModel="inprocess" />
  </system.webServer>
</configuration>
